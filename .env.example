# Core network settings
FRITZBOX_ROUTER_IP=192.168.178.1
HOMELAB_SERVER_IP=192.168.178.2
LOCAL_DOMAIN=home.arpa

# Runtime data layout
HOMELAB_STATE_DIR=/homelab/state
HOMELAB_STORAGE_DIR=/homelab/storage

# Homepage Uptime Kuma widget configuration.
# Create a local Uptime Kuma status page with this slug.
HOMEPAGE_VAR_UPTIME_KUMA_STATUS_SLUG=homelab

# Homepage Technitium widget configuration.
# Create a dedicated Technitium API user and token, then set the token here locally.
HOMEPAGE_VAR_TECHNITIUM_API_KEY=

# Change this in your local .env before first start.
DNS_SERVER_ADMIN_PASSWORD=change-me

# Optional: uncomment if you want Technitium to use explicit upstream forwarders.
# DNS_SERVER_FORWARDERS=1.1.1.1,1.0.0.1
